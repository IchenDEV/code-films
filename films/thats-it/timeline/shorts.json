 "caps": [
  {
   "id": "L01",
   "a": 0,
   "b": 2.563,
   "zh": "你是不是也觉得——AI 有点傻？",
   "en": "Do you think AI is kind of dumb?"
  },
  {
   "id": "L02",
   "a": 2.583,
   "b": 5.683,
   "zh": "它推荐的馆子，三年前就关门了。",
   "en": "The restaurant it recommended closed three years ago."
  },
  {
   "id": "L03",
   "a": 5.703,
   "b": 7.808,
   "zh": "你心想：就这？",
   "en": "You thought: That's it?"
  },
  {
   "id": "L05",
   "a": 7.828,
   "b": 12.117,
   "zh": "可隔壁有人，用它一下午做完一个月的活。",
   "en": "But next door, someone used it to do a month of work in one afternoon."
  },
  {
   "id": "L06",
   "a": 12.137,
   "b": 16.458,
   "zh": "他后背发凉：要变天了。",
   "en": "A chill down his back: everything is about to change."
  },
  {
   "id": "L07",
   "a": 16.478,
   "b": 18.457,
   "zh": "你们俩，谁看错了？",
   "en": "So which of you is wrong?"
  },
  {
   "id": "L08",
   "a": 18.477,
   "b": 21.578,
   "zh": "都没有。只是站的地方不一样。",
   "en": "Neither. You're standing in different places."
  },
  {
   "id": "L09",
   "a": 21.598,
   "b": 24.465,
   "zh": "把八十亿人排成一个漏斗——",
   "en": "Line up eight billion people as a funnel—"
  },
  {
   "id": "L10",
   "a": 24.485,
   "b": 26.545,
   "zh": "六十亿人，基本没碰过它；",
   "en": "six billion have barely touched it;"
  },
  {
   "id": "L11",
   "a": 26.565,
   "b": 29.105,
   "zh": "十到二十亿人，就见过一个聊天框；",
   "en": "one to two billion only know the chatbot;"
  },
  {
   "id": "L12",
   "a": 29.125,
   "b": 32.585,
   "zh": "两千万人，看它一句话做完几个月的活；",
   "en": "twenty million watch it do months of work from one sentence;"
  },
  {
   "id": "L13",
   "a": 32.605,
   "b": 36.319,
   "zh": "最底下只有五千人。他们看见了什么？",
   "en": "and at the bottom, five thousand. What do they see?"
  },
  {
   "id": "L14",
   "a": 36.339,
   "b": 38.881,
   "zh": "一杯水，量不出海有多深；",
   "en": "A cup of water can't measure the sea;"
  },
  {
   "id": "L15",
   "a": 38.901,
   "b": 41.721,
   "zh": "问题越大，它就越深。",
   "en": "the bigger your problem, the deeper it goes."
  },
  {
   "id": "L17",
   "a": 41.741,
   "b": 45.841,
   "zh": "能对答案的地方——算式、代码——它高得惊人；",
   "en": "Wherever answers can be checked—math, code—it towers;"
  },
  {
   "id": "L19",
   "a": 45.861,
   "b": 48.618,
   "zh": "找馆子、过日子，还在山谷里。",
   "en": "finding dinner is still down in the valley."
  },
  {
   "id": "L20",
   "a": 48.638,
   "b": 51.552,
   "zh": "门外的人，只看过预告片。",
   "en": "Those outside have only seen the trailer."
  },
  {
   "id": "L21",
   "a": 51.572,
   "b": 53.95,
   "zh": "门里那五千人看见的是——",
   "en": "Inside, the five thousand see—"
  },
  {
   "id": "L22",
   "a": 53.97,
   "b": 58.205,
   "zh": "成千上万个 AI，几周做完高手几年的活；",
   "en": "thousands of AIs doing in weeks what experts need years for;"
  },
  {
   "id": "L23",
   "a": 58.225,
   "b": 61.981,
   "zh": "曲线立了起来——快到人都看不懂。",
   "en": "the curve goes vertical—too fast for people to follow."
  },
  {
   "id": "L24",
   "a": 62.834,
   "b": 65.487,
   "zh": "这是 Karpathy 画的漏斗。",
   "en": "This is Andrej Karpathy's funnel."
  },
  {
   "id": "L28",
   "a": 65.507,
   "b": 68.367,
   "zh": "所以，说“就这？”的人没有错——",
   "en": "So whoever says \"That's it?\" isn't wrong—"
  },
  {
   "id": "L29",
   "a": 68.387,
   "b": 71.487,
   "zh": "只是还没问它，真正在乎的问题。",
   "en": "they just haven't asked the question they truly care about."
  },
  {
   "id": "L30",
   "a": 71.507,
   "b": 75.557,
   "zh": "就这？——不，就从这儿开始。",
   "en": "That's it? No. This is where it starts."
  }
 ],
