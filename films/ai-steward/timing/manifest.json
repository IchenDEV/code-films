{
 "h1": {
  "hash": "25041c6153b5",
  "duration": 1.819,
  "text": "AI 越来越能干了。",
  "rate": 4.4
 },
 "h2": {
  "hash": "f0b2905db408",
  "duration": 3.669,
  "text": "可你有没有发现——我们反而越来越忙了？",
  "rate": 4.36
 },
 "h3": {
  "hash": "50b50595a32c",
  "duration": 4.613,
  "text": "十个会话，五十个，一百个，每一个都在干活。",
  "rate": 3.68
 },
 "h4": {
  "hash": "c8bbdf887490",
  "duration": 5.589,
  "text": "而你，在它们之间来回切换、复制、粘贴、追问、确认。",
  "rate": 3.4
 },
 "h5": {
  "hash": "c4d36db0dd4c",
  "duration": 5.473,
  "text": "你以为自己在指挥 AI，其实，你成了它们之间最慢的那根网线。",
  "rate": 4.75
 },
 "p1": {
  "hash": "69ea6a2077d0",
  "duration": 2.255,
  "text": "问题不在 AI 不够聪明。",
  "rate": 4.43
 },
 "p2": {
  "hash": "4a82aa0279eb",
  "duration": 3.471,
  "text": "问题在于：每一件事，都要等你开口。",
  "rate": 4.03
 },
 "p3": {
  "hash": "7f3ee1a740c9",
  "duration": 3.213,
  "text": "可真实的工作，从来不是一问一答。",
  "rate": 4.36
 },
 "p4": {
  "hash": "a287d4c3b082",
  "duration": 3.832,
  "text": "一封邮件进来了。线上，用户又在吐槽。",
  "rate": 3.91
 },
 "p5": {
  "hash": "23625849f997",
  "duration": 6.056,
  "text": "群里有人@了一句，另一个 Agent 交回了结果，下游的活，刚刚干完。",
  "rate": 4.29
 },
 "p6": {
  "hash": "8e018ab6cb33",
  "duration": 3.346,
  "text": "它们不分先后，不打招呼，随时都会来。",
  "rate": 4.48
 },
 "g1": {
  "hash": "dd6ba673bd7b",
  "duration": 3.601,
  "text": "所以这几个月，大家开始讲 Loop Engineering：",
  "rate": 3.61
 },
 "g2": {
  "hash": "e0428da870e0",
  "duration": 4.734,
  "text": "别再一句一句地提示 AI，去设计那个替你提示它的循环。",
  "rate": 5.07
 },
 "g3": {
  "hash": "14d08081ccd9",
  "duration": 2.807,
  "text": "再往前一步，是 Graph Engineering：",
  "rate": 2.85
 },
 "g4": {
  "hash": "e3c7c26145c3",
  "duration": 6.631,
  "text": "把工作画成一张图——谁来做，谁接力，哪里校验，哪里必须停下来问人。",
  "rate": 4.07
 },
 "g5": {
  "hash": "cafefe8428ee",
  "duration": 2.695,
  "text": "但是，图画好了，就够了吗？",
  "rate": 3.71
 },
 "g6": {
  "hash": "2e57049f86ad",
  "duration": 3.528,
  "text": "不够！因为明天，还会来一封新的邮件。",
  "rate": 4.25
 },
 "k1": {
  "hash": "3184ebf5e774",
  "duration": 2.533,
  "text": "所以，我们需要一位大管家。",
  "rate": 4.34
 },
 "k2": {
  "hash": "67cd26f40322",
  "duration": 3.61,
  "text": "它站在所有执行者之上，接住每一个信号：",
  "rate": 4.71
 },
 "k3": {
  "hash": "99a7d9a71e6d",
  "duration": 5.042,
  "text": "这是新事还是老事？该交给谁？原来的安排，要不要改？",
  "rate": 4.16
 },
 "k4": {
  "hash": "ef6725cf68bf",
  "duration": 3.543,
  "text": "会话卡住了，它去找另一个会话补信息；",
  "rate": 4.52
 },
 "k5": {
  "hash": "535f200810c7",
  "duration": 2.673,
  "text": "结果跑偏了，它打回去重做；",
  "rate": 4.12
 },
 "k6": {
  "hash": "e4cd06cddd48",
  "duration": 3.991,
  "text": "需求变了，它把整张图，重新连一遍。",
  "rate": 3.51
 },
 "k7": {
  "hash": "2d8c1fd2d4f4",
  "duration": 1.666,
  "text": "这张图，是活的！",
  "rate": 3.6
 },
 "r1": {
  "hash": "70f078078661",
  "duration": 1.101,
  "text": "那人做什么？",
  "rate": 4.54
 },
 "r2": {
  "hash": "1e1d9df7b7af",
  "duration": 4.004,
  "text": "只做最值钱的事：定目标，做取舍，拍板。",
  "rate": 3.75
 },
 "r3": {
  "hash": "97ae01698c62",
  "duration": 3.462,
  "text": "大管家带着背景、选项和影响来找你。",
  "rate": 4.33
 },
 "r4": {
  "hash": "cce49b7167b5",
  "duration": 4.016,
  "text": "你说一句“就这么办”，整张网络，重新流动起来。",
  "rate": 4.48
 },
 "z1": {
  "hash": "84fb756ddb94",
  "duration": 4.75,
  "text": "过去，我们用软件，是打开它、命令它、等它回答。",
  "rate": 3.79
 },
 "z2": {
  "hash": "d8804ce586b9",
  "duration": 6.793,
  "text": "接下来，是把一件事托付出去——信息自己流进来，工作自己往前走。",
  "rate": 3.83
 },
 "z3": {
  "hash": "b8d52ddf1cbe",
  "duration": 3.571,
  "text": "AI 负责执行，大管家负责协调，",
  "rate": 3.64
 },
 "z4": {
  "hash": "f53ed0521034",
  "duration": 1.682,
  "text": "而你，负责方向。",
  "rate": 3.57
 },
 "z5": {
  "hash": "4e0d28eba50e",
  "duration": 5.219,
  "text": "这还只是一个设想，需要去验证。但我相信，它值得被造出来。",
  "rate": 4.6
 }
}